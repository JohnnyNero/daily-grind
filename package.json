{
  "name": "landlord",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && npm run build:cafe",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:cafe",
    "dev:cafe": "vite cafe --host",
    "build:cafe": "tsc --noEmit -p cafe && vite build cafe",
    "test:cafe": "vitest run --root cafe"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
